{
  "project_id": "diesel-tempo-wn96h",
  "database_id": "ai-studio-4140a9f0-ab04-46b4-b012-80a6e9a55cdf",
  "collections": [
    {
      "name": "users",
      "fields": [
        { "name": "name", "type": "string" },
        { "name": "email", "type": "string" },
        { "name": "role", "type": "string" },
        { "name": "createdAt", "type": "timestamp" }
      ],
      "rules": [
        { "action": "read", "condition": "request.auth != null" },
        { "action": "write", "condition": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'" }
      ]
    },
    {
      "name": "patients",
      "fields": [
