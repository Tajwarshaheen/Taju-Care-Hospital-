        { "name": "emergencyContact", "type": "string" },
        { "name": "bloodGroup", "type": "string" },
        { "name": "assignedDoctorId", "type": "string", "optional": true },
        { "name": "departmentId", "type": "string", "optional": true },
        { "name": "status", "type": "string" }
      ],
      "rules": [
        { "action": "read", "condition": "request.auth != null" },
        { "action": "write", "condition": "request.auth != null" }
      ]
    },
    {
      "name": "doctors",
      "fields": [
